<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>syncfusion.samplebrowser.wpf.spreadsheeteditorsdk</AssemblyName>
    <RootNamespace>syncfusion.samplebrowser.wpf</RootNamespace>
    <TargetFrameworkVersion></TargetFrameworkVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-windows' ">
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.DisableDynamicResourceOptimization" Value="true" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFRAMEWORK' ">
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml"></Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Common/syncfusion.demoscommon.wpf_lib_Net80.csproj">
      <Name>syncfusion.demoscommon.wpf_lib</Name>
    </ProjectReference>
    <ProjectReference Include="../showcase/spreadsheet/syncfusion.spreadsheetdemo.wpf_lib_Net80.csproj">
      <Name>syncfusion.spreadsheetdemo.wpf_lib</Name>
    </ProjectReference>
    <ProjectReference Include="../spreadsheet/syncfusion.spreadsheetdemos.wpf_lib_Net80.csproj">
      <Name>syncfusion.spreadsheetdemos.wpf_lib</Name>
    </ProjectReference>
    <PackageReference Include="Syncfusion.Tools.Wpf" Version="33.2.3" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Binaries_*\**" />
    <EmbeddedResource Remove="Binaries_*\**" />
    <Page Remove="Binaries_*\**" />
    <None Remove="Binaries_*\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Properties\Settings.settings" />
    <None Remove="App.config" />
    <Compile Remove="AutomationMail.cs" />
    <None Remove="packages.config" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="wpf-spreadsheet-editor-sdk-splash-screen.png" />
    <Resource Include="App.ico" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationIcon>App.ico</ApplicationIcon>
  </PropertyGroup>
  <Import Project="..\Common\demos.common.props"></Import>
  <Import Project="..\targets\MultiTargeting_Net80.targets" />
  <PropertyGroup>
    <DefineConstants>TRACE;NET50;SPREADSHEETEDITORSDK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)'=='net462' ">
    <SyncfusionAssemblyLocation>4.6.2</SyncfusionAssemblyLocation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)'=='net8.0-windows' ">
    <SyncfusionAssemblyLocation>net8.0</SyncfusionAssemblyLocation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)'=='net9.0-windows' ">
    <SyncfusionAssemblyLocation>net9.0</SyncfusionAssemblyLocation>
  </PropertyGroup>
</Project>