<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>syncfusion.spreadsheetdemos.wpfapplication</AssemblyName>
    <RootNamespace>syncfusion.spreadsheetdemos.wpf</RootNamespace>
    <TargetFrameworkVersion>
    </TargetFrameworkVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-windows' ">
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.DisableDynamicResourceOptimization" Value="true" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFRAMEWORK' ">
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml">
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Syncfusion.Linq.base" Version="31.2.2." />
    <PackageReference Include="Syncfusion.Compression.Base" Version="31.2.2." />
    <PackageReference Include="Syncfusion.Data.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.GridCommon.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.SfCellGrid.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.SfGrid.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.SfGridCommon.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.ExcelToPdfConverter.Wpf" Version="31.2.2." />
    <PackageReference Include="Syncfusion.ExcelChartToImageConverter.Wpf" Version="31.2.2." />
    <PackageReference Include="Syncfusion.Pdf.Wpf" Version="31.2.2." />
    <PackageReference Include="Syncfusion.PdfViewer.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.SfSpreadsheet.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.SfSpreadsheetHelper.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.Tools.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.XlsIO.Wpf" Version="31.2.2." />
    <PackageReference Include="Syncfusion.SfChart.WPF" Version="31.2.2." />
    <PackageReference Include="Syncfusion.ExcelChartToImageConverter.Wpf" Version="31.2.2." />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\syncfusion.demoscommon.wpf_lib.csproj">
      <Name>syncfusion.demoscommon.wpf_lib</Name>
    </ProjectReference>
    <ProjectReference Include="syncfusion.spreadsheetdemos.wpf_lib.csproj">
      <Name>syncfusion.spreadsheetdemos.wpf_lib</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Properties\Settings.settings" />
    <None Remove="packages.config" />
    <None Remove="App.config" />
    <None Remove="Assets\**" />
    <Compile Remove="Behavior\**" />
    <None Remove="Data\**" />
    <Page Remove="Views\**" />
    <Compile Remove="Views\**" />
    <Compile Remove="SpreadsheetDemosViewModel.cs" />
  </ItemGroup>
  <Import Project="..\Common\demos.common.props">
  </Import>
  <Import Project="..\targets\MultiTargeting.targets" />
  <PropertyGroup Condition=" '$(TargetFramework)'=='net462' ">
    <SyncfusionAssemblyLocation>4.6.2</SyncfusionAssemblyLocation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)'=='net8.0-windows' ">
    <SyncfusionAssemblyLocation>net8.0</SyncfusionAssemblyLocation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)'=='net9.0-windows' ">
    <SyncfusionAssemblyLocation>net9.0</SyncfusionAssemblyLocation>
  </PropertyGroup>
</Project>